#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Dependencies survive snapshots and pauses; never reinstall on wake.
if [[ "$(node --version)" != v24.* ]] ||
   [[ "$(bun --version)" != 1.3.10 ]] ||
   [[ ! -f node_modules/astro/package.json ]]; then
  echo 'Orb prerequisites are missing or outdated; run .agents/setup.' >&2
  exit 1
fi

echo 'Orb ready: Node 24, Bun 1.3.10, and Astro dependencies available'
