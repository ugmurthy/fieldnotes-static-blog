#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Match .github/workflows/ci.yml without replacing the orb's system tools.
toolchain="$HOME/.local/share/fieldnotes-toolchain"
export PATH="$toolchain/node_modules/.bin:$PATH"
TIMEFORMAT='Step completed in %3R seconds'

echo 'Preparing Node 24 and Bun 1.3.10'
time {
  if [[ "$(node --version 2>/dev/null || true)" != v24.* ]] ||
     [[ "$(bun --version 2>/dev/null || true)" != 1.3.10 ]]; then
    npm install --prefix "$toolchain" --no-save --no-package-lock --no-audit --no-fund node@24 bun@1.3.10
  fi
  node --version
  bun --version
}

# Amp and supervised services use separate non-interactive login shells.
profile_marker='# Fieldnotes orb toolchain'
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
case "\$PWD/" in
  "$repo_root/"*) export PATH="$toolchain/node_modules/.bin:\$PATH" ;;
esac
EOF
fi

echo 'Installing locked dependencies'
time bun install --frozen-lockfile
echo 'Orb setup ready'
